DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lookbook
DB_PASSWORD=change-me
DB_NAME=lookbook
DB_CHARSET=utf8mb4

APP_ENV=production
# 本地开发可改为 development，并显式启用以下两项：
# DB_DRIVER=sqlite
# APP_DB_PATH=var/app.db

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://example.com/api/auth/wechat/callback
WECHAT_DEV_LOGIN=false
COOKIE_SECURE=true

ADMIN_USERNAME=
ADMIN_PASSWORD=
# 仅在明确接受弱密码风险时启用；公网生产环境强烈不建议。
ALLOW_WEAK_ADMIN_PASSWORD=false

# 单进程应用层限速；生产环境仍应在 Nginx/WAF 设置全局限速。
RATE_LIMIT_ADMIN_LOGIN=10
RATE_LIMIT_DEV_LOGIN=30
RATE_LIMIT_PAYMENT_AUTH=30
RATE_LIMIT_JOB_CREATE=20
RATE_LIMIT_OAUTH_CALLBACK=30

IMAGE2_API_KEY=
IMAGE2_BASE_URL=
IMAGE2_BYPASS_PROXY=false
IMAGE2_PARALLELISM=5
IMAGE2_GLOBAL_PARALLELISM=5
IMAGE2_MAX_ATTEMPTS=4
IMAGE2_RETRY_DELAY=60
POSTPROCESS_QUALITY_GATE=true

QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
QWEN_RESPONSE_FORMAT=auto
QWEN_VALIDATION_ATTEMPTS=3

APP_OUTPUT_ROOT=outputs
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_MAX_UPLOAD_BYTES=20971520
WEB_MAX_IMAGE_PIXELS=40000000
WEB_MAX_ACTIVE_JOBS=4
WEB_MAX_QUEUED_JOBS=100
WEB_MAX_CONCURRENT_UPLOADS=8
WEB_UPLOAD_SLOT_TIMEOUT_SECONDS=10
WEB_JOB_TIMEOUT_SECONDS=3600
WEB_QUEUE_TIMEOUT_SECONDS=7200
WEB_ORPHAN_RESERVATION_TIMEOUT_SECONDS=86400
WEB_MAINTENANCE_INTERVAL_SECONDS=30
AUTH_RESET_ON_START=false

APP_PUBLIC_URL=https://example.com
PAYMENT_REQUIRED=true
PAY_CREATE_URL=/jewelry-lookbook-sheet/pay.php
PAY_BRIDGE_SECRET=
DOWNLOAD_TRANSFER_SECRET=
DOWNLOAD_TRANSFER_TTL_SECONDS=600
WX_APPID=
WX_MCH_ID=
WX_API_V3_KEY=
WX_PRIVATE_KEY_PATH=cert/apiclient_key.pem
WX_MCH_CERT_PATH=cert/apiclient_cert.pem
# 已直接配置商户证书序列号时，可省略证书解析：
# WX_MCH_SERIAL_NO=
WX_PLATFORM_PUBLIC_KEY_PATH=cert/pub_key.pem
WX_PLATFORM_PUBLIC_KEY_ID=PUB_KEY_ID_...
WX_NOTIFY_URL=https://example.com/jewelry-lookbook-sheet/notify/wxpay.php
